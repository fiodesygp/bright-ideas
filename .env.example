# Copy to .env.local for local work. Never commit real values.

# Server only (Vercel → Settings → Environment Variables, Production and Preview).
# The secret key (sb_secret_…) from Supabase → Project Settings → API Keys.
# Never use the publishable key, and never prefix these with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Client (baked into the build). Leave unset on Vercel: the app posts to
# /api/sync on the same site. The GitHub Pages workflow sets the full URL.
VITE_SYNC_URL=https://brightideas-agripv.vercel.app/api/sync
